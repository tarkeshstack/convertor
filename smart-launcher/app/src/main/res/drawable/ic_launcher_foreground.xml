<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone case — sized to fill most of the icon canvas so it reads boldly even
         small, rather than a small centered glyph. -->
    <path
        android:fillColor="#1C1E24"
        android:pathData="M42,12 L66,12 A12,12 0 0 1 78,24 L78,86 A12,12 0 0 1 66,98 L42,98 A12,12 0 0 1 30,86 L30,24 A12,12 0 0 1 42,12 Z" />

    <!-- Screen, gradient-shaded top-to-bottom for a glossy, dimensional look. -->
    <path android:pathData="M40,22 L68,22 A4,4 0 0 1 72,26 L72,82 A4,4 0 0 1 68,86 L40,86 A4,4 0 0 1 36,82 L36,26 A4,4 0 0 1 40,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36" android:startY="22"
                android:endX="72" android:endY="86"
                android:startColor="#9CC0FA"
                android:endColor="#2E5AAC" />
        </aapt:attr>
    </path>

    <!-- Glossy highlight streak across the screen. -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M38,24 L48,24 L40,50 L36,50 Z" />

    <!-- Camera dot. -->
    <path
        android:fillColor="#0F1013"
        android:pathData="M52,17 A2,2 0 1 1 56,17 A2,2 0 1 1 52,17 Z" />

    <!-- Home indicator pill. -->
    <path
        android:fillColor="#E7EDFB"
        android:pathData="M49,90 L59,90 A2,2 0 1 1 59,94 L49,94 A2,2 0 1 1 49,90 Z" />
</vector>
