<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone case — sized to fill nearly the whole icon canvas, bigger than a typical
         small centered glyph. -->
    <path
        android:fillColor="#1C1E24"
        android:pathData="M32,6 L76,6 A14,14 0 0 1 90,20 L90,88 A14,14 0 0 1 76,102 L32,102 A14,14 0 0 1 18,88 L18,20 A14,14 0 0 1 32,6 Z" />

    <!-- Screen, gradient-shaded top-to-bottom for a glossy, dimensional look. -->
    <path android:pathData="M32,16 L76,16 A6,6 0 0 1 82,22 L82,82 A6,6 0 0 1 76,88 L32,88 A6,6 0 0 1 26,82 L26,22 A6,6 0 0 1 32,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="16"
                android:endX="82" android:endY="88"
                android:startColor="#9CC0FA"
                android:endColor="#2E5AAC" />
        </aapt:attr>
    </path>

    <!-- A 2x2 grid of colorful app icons on the screen, evoking a home-screen app grid. -->
    <path android:fillColor="#8B5CF6" android:pathData="M34,26 L46,26 A4,4 0 0 1 50,30 L50,42 A4,4 0 0 1 46,46 L34,46 A4,4 0 0 1 30,42 L30,30 A4,4 0 0 1 34,26 Z" />
    <path android:fillColor="#22C55E" android:pathData="M62,26 L74,26 A4,4 0 0 1 78,30 L78,42 A4,4 0 0 1 74,46 L62,46 A4,4 0 0 1 58,42 L58,30 A4,4 0 0 1 62,26 Z" />
    <path android:fillColor="#F97316" android:pathData="M34,54 L46,54 A4,4 0 0 1 50,58 L50,70 A4,4 0 0 1 46,74 L34,74 A4,4 0 0 1 30,70 L30,58 A4,4 0 0 1 34,54 Z" />
    <path android:fillColor="#EC4899" android:pathData="M62,54 L74,54 A4,4 0 0 1 78,58 L78,70 A4,4 0 0 1 74,74 L62,74 A4,4 0 0 1 58,70 L58,58 A4,4 0 0 1 62,54 Z" />

    <!-- Camera dot. -->
    <path
        android:fillColor="#0F1013"
        android:pathData="M52.4,11 A1.6,1.6 0 1 1 55.6,11 A1.6,1.6 0 1 1 52.4,11 Z" />

    <!-- Home indicator pill. -->
    <path
        android:fillColor="#E7EDFB"
        android:pathData="M49,95 L59,95 A2,2 0 1 1 59,99 L49,99 A2,2 0 1 1 49,95 Z" />
</vector>
